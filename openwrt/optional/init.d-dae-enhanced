#!/bin/sh /etc/rc.common
# =============================================================================
# dae - 基于 eBPF 的高性能透明代理（OpenWrt / ImmortalWrt procd 服务脚本）
#
# 功能：
#   * 启动前用 `dae validate` 校验配置，坏配置不启动、不覆盖正在运行的好配置
#   * 热重载：`/etc/init.d/dae reload` 走 `dae reload`（SIGUSR1），既有连接不中断
#   * 内存保护：以 GOMEMLIMIT 给 Go 运行时设软上限，避免路由器 OOM
#   * 日志管理：默认交给 logd（logread -e dae），可选写文件并自动轮转
#   * 内核前置检查：BTF 缺失时给出明确报错，并自动挂载 bpffs
#   * 配置权限：强制 0600，防止订阅链接与节点凭据泄露
#
# UCI 配置：/etc/config/dae
# 常用命令：
#   /etc/init.d/dae start|stop|restart|reload|enable|disable|status
#   /etc/init.d/dae validate     # 仅校验配置
#   /etc/init.d/dae version      # 查看当前二进制版本
# =============================================================================

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/dae
DEFAULT_CONFIG_FILE=/etc/dae/config.dae
DEFAULT_GEO_DIR=/usr/share/dae
BPF_FS=/sys/fs/bpf
BTF_FILE=/sys/kernel/btf/vmlinux

EXTRA_COMMANDS="validate version"
EXTRA_HELP="	validate	校验 /etc/dae/config.dae 配置语法
	version		显示当前 dae 二进制版本"

log_info() { logger -t dae -p daemon.info "$*"; }
log_warn() { logger -t dae -p daemon.warn "$*"; echo "dae: $*" >&2; }
log_err()  { logger -t dae -p daemon.err  "$*"; echo "dae: $*" >&2; }

load_config() {
	config_load dae 2>/dev/null || true

	config_get_bool ENABLED  dae enabled  0
	config_get CFG_FILE      dae config_file "$DEFAULT_CONFIG_FILE"
	config_get GEO_DIR       dae geo_dir   "$DEFAULT_GEO_DIR"
	config_get GOMEMLIMIT    dae gomemlimit "256MiB"
	config_get LOG_FILE      dae log_file  ""
	config_get LOG_MAXSIZE   dae log_maxsize "30"
	config_get LOG_MAXBACKUPS dae log_maxbackups "3"
	config_get EXTRA_ARGS    dae extra_args ""
	config_get RESP_THRESHOLD dae respawn_threshold "3600"
	config_get RESP_TIMEOUT   dae respawn_timeout "5"
	config_get RESP_RETRY     dae respawn_retry "5"
	config_get_bool CHECK_BTF  dae check_btf 1
	config_get_bool MOUNT_BPFFS dae mount_bpffs 1

	[ -n "$CFG_FILE" ] || CFG_FILE="$DEFAULT_CONFIG_FILE"
	[ -n "$GEO_DIR" ]  || GEO_DIR="$DEFAULT_GEO_DIR"
}

# eBPF 依赖内核 BTF（CO-RE）。缺失时 dae 会在加载 eBPF 时失败，
# 这里提前给出可读的错误提示。
kernel_check() {
	[ "$CHECK_BTF" = "1" ] || return 0
	if [ ! -r "$BTF_FILE" ]; then
		log_err "内核缺少 $BTF_FILE：未开启 CONFIG_DEBUG_INFO_BTF，dae 的 eBPF 程序无法加载"
		log_err "请刷入带 BTF 的 ImmortalWrt 固件（filogic 官方固件默认已开启）"
		return 1
	fi
	return 0
}

# dae 的 eBPF map pin 在 /sys/fs/bpf，必须先挂载 bpffs
mount_bpffs() {
	[ "$MOUNT_BPFFS" = "1" ] || return 0
	mkdir -p "$BPF_FS" 2>/dev/null
	if ! grep -qs "[[:space:]]$BPF_FS[[:space:]]" /proc/mounts; then
		if mount -t bpf bpf "$BPF_FS" 2>/dev/null; then
			log_info "已挂载 bpffs 到 $BPF_FS"
		else
			log_warn "挂载 bpffs 到 $BPF_FS 失败，dae 可能无法启动"
		fi
	fi
	return 0
}

# 配置校验的公共逻辑：成功打印信息，失败打印首行错误
config_validate() {
	local vout
	if vout="$("$PROG" validate -c "$CFG_FILE" 2>&1)"; then
		return 0
	fi
	VALIDATE_ERROR="$(echo "$vout" | head -n 1)"
	return 1
}

start_service() {
	load_config

	[ "$ENABLED" = "1" ] || {
		log_info "服务未启用；执行 uci set dae.dae.enabled=1 && uci commit dae 后再启动"
		return 0
	}

	[ -f "$CFG_FILE" ] || { log_err "配置文件不存在：$CFG_FILE"; return 1; }

	# 权限规范：config.dae 可能含订阅链接与节点凭据，强制 0600
	chmod 0600 "$CFG_FILE" 2>/dev/null

	kernel_check || return 1
	mount_bpffs

	if ! config_validate; then
		log_err "配置校验失败：$VALIDATE_ERROR"
		return 1
	fi

	procd_open_instance dae
	procd_set_param command "$PROG" run --disable-timestamp -c "$CFG_FILE"

	# 日志：默认写 stdout/stderr 交给 logd；设置 log_file 则写文件并自动轮转
	if [ -n "$LOG_FILE" ]; then
		procd_append_param command --logfile "$LOG_FILE" \
			--logfile-maxsize "$LOG_MAXSIZE" \
			--logfile-maxbackups "$LOG_MAXBACKUPS"
	fi

	# 额外的自定义命令行参数
	# shellcheck disable=SC2086
	[ -n "$EXTRA_ARGS" ] && procd_append_param command $EXTRA_ARGS

	# GOMEMLIMIT：Go 运行时内存软上限，路由器内存有限时非常关键
	[ -n "$GOMEMLIMIT" ] && procd_set_param env GOMEMLIMIT="$GOMEMLIMIT"
	# 明确 geo 数据目录（dae 会在此查找 geoip.dat / geosite.dat）
	procd_set_param env DAE_LOCATION_ASSET="$GEO_DIR"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn "$RESP_THRESHOLD" "$RESP_TIMEOUT" "$RESP_RETRY"
	procd_set_param limits nofile="65535"
	# 声明依赖的配置文件，便于 procd 跟踪
	procd_set_param file "$CFG_FILE"
	procd_close_instance

	log_info "dae 已启动（配置：$CFG_FILE，GOMEMLIMIT=${GOMEMLIMIT:-未设置}）"
}

stop_service() {
	log_info "正在停止 dae（进程退出时会自行清理 eBPF 挂载与 pin）"
	return 0
}

# 热重载：不中断既有连接地重新加载配置
reload_service() {
	load_config

	[ "$ENABLED" = "1" ] || { log_info "服务未启用，忽略 reload"; return 0; }
	[ -f "$CFG_FILE" ] || { log_err "配置文件不存在：$CFG_FILE"; return 1; }

	# 先用新配置做校验：校验不通过则保持当前运行状态，避免“重载即瘫痪”
	if ! config_validate; then
		log_err "reload 已中止：新配置校验失败（当前运行状态保持不变）：$VALIDATE_ERROR"
		return 1
	fi

	# dae reload 通过 SIGUSR1 触发原地热重载，既有连接不断开
	if "$PROG" reload >/dev/null 2>&1; then
		log_info "配置热重载成功（既有连接未中断）"
		return 0
	fi

	log_warn "热重载失败（进程可能未运行或 pid 文件缺失），回退为重启服务"
	restart
}

service_triggers() {
	# /etc/config/dae 变更后触发 reload
	procd_add_reload_trigger "dae"
	# WAN 状态变化后热重载，让 dae 重新探测出口接口
	procd_add_interface_trigger "interface.*" "wan" "/etc/init.d/dae reload"
}

validate() {
	load_config
	[ -f "$CFG_FILE" ] || { echo "配置文件不存在：$CFG_FILE"; return 1; }
	if "$PROG" validate -c "$CFG_FILE"; then
		echo "配置校验通过：$CFG_FILE"
		return 0
	fi
	echo "配置校验失败：$CFG_FILE"
	return 1
}

version() {
	[ -x "$PROG" ] || { echo "未找到 $PROG"; return 1; }
	"$PROG" --version
}
